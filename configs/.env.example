# Copy to .env and export, or set these in your deployment environment.
# Every value below is the built-in default.

# development | staging | production
APP_ENV=development

# Listen address. Use :8080 so the container binds all interfaces.
HTTP_ADDR=:8080

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Per-request deadline. Set to 0 to disable.
HTTP_REQUEST_TIMEOUT=10s

# Maximum accepted request body size in bytes.
HTTP_MAX_BODY_BYTES=32768

# Browser origins allowed to call the API, comma separated. The static blog is
# served from a different origin, so it must be listed here or the browser
# blocks its requests. "*" is the development default; a real deployment should
# name its origins, e.g. https://blog.example.com,http://localhost:2077
HTTP_CORS_ORIGINS=*

COMMENT_DEFAULT_PAGE_SIZE=20
COMMENT_MAX_PAGE_SIZE=100
