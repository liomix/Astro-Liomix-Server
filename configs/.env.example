# Copy to .env and export, or set these in your deployment environment.
# Every value below is the built-in default.

# development | staging | production
#
# In development the server seeds a default administrator (admin / astroadmin123)
# and the login page displays those credentials until the password is changed.
# Other environments never seed it, never store the plaintext password and never
# show credentials on the login page.
APP_ENV=development

# Listen address. Use :8080 so the container binds all interfaces.
HTTP_ADDR=:8080

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Per-request deadline. Set to 0 to disable.
HTTP_REQUEST_TIMEOUT=10s

# Maximum accepted request body size in bytes.
HTTP_MAX_BODY_BYTES=32768

# Browser origins allowed to call the API, comma separated. The static blog is
# served from a different origin, so it must be listed here or the browser
# blocks its requests. "*" is the development default; a real deployment should
# name its origins, e.g. https://blog.example.com,http://localhost:2077
HTTP_CORS_ORIGINS=*

# Shared secret for the moderation routes (approve / delete a comment), sent as
# "Authorization: Bearer <token>". Leave it empty and those routes are not
# mounted at all — that is the safe default. At least 16 characters, e.g.
#   openssl rand -hex 24
#
# This is the legacy path: administrators normally sign in through
# POST /api/v1/admin/auth/login and present the session token instead. Keep the
# static token only as an emergency way in, or leave it empty.
ADMIN_TOKEN=

# How long an administrator's sign-in lasts. Absolute, not sliding: an active
# attacker must not be able to keep a stolen token alive forever.
ADMIN_SESSION_TTL=168h

# Optional, for automated first boot only. Accounts live in the database; the
# normal way to create one is the CLI, which never puts a password in the
# environment:
#   server admin create -username owner
#   echo '<password>' | server admin create -username owner -password-stdin
#
# When these two are set, the server creates the account once, only if the table
# is empty, then ignores them. Set both or neither. Remove them after the first
# sign-in — a password in the environment is a credential.
#   ADMIN_BOOTSTRAP_USERNAME=owner
#   ADMIN_BOOTSTRAP_PASSWORD=<at least 12 characters>
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Mark the /admin console cookies Secure. Turn this on in production, where the
# console is served over HTTPS; leave it off for http://localhost development,
# otherwise the browser refuses to store the session cookie and sign-in silently
# fails.
ADMIN_COOKIE_SECURE=false

COMMENT_DEFAULT_PAGE_SIZE=20
COMMENT_MAX_PAGE_SIZE=100

# PostgreSQL connection string. Blank is only allowed in development, where it
# falls back to postgres://postgres@localhost:5432/Blog?sslmode=disable and the
# password comes from %APPDATA%\postgresql\pgpass.conf (or ~/.pgpass), the same
# file psql reads. Staging and production must set it explicitly.
#
# The schema is created and migrated at startup, so the database has to exist
# but the tables do not:
#   CREATE DATABASE "Blog";
# DATABASE_URL=postgres://blog:secret@localhost:5432/Blog?sslmode=disable
DATABASE_URL=

# Connection pool. Idle connections must not exceed the open cap.
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
